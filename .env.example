# OrbitChat uses per-app env files:
#   apps/web/.env            <- copy from apps/web/.env.example   (public, bundled into the browser)
#   apps/worker/.dev.vars    <- copy from apps/worker/.dev.vars.example (server secrets for wrangler dev)
# Production secrets: `wrangler secret put <NAME> --env production` (see docs/deployment.md)
#
# Optional: Supabase CLI local Google OAuth (supabase/config.toml)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
# Optional: Playwright target
E2E_BASE_URL=http://localhost:5173
