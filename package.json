{
  "name": "talksy",
  "private": true,
  "version": "1.0.0",
  "description": "Talksy - anonymous, real-time random stranger text chat",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @orbit/web --filter @orbit/worker dev",
    "dev:web": "pnpm --filter @orbit/web dev",
    "dev:worker": "pnpm --filter @orbit/worker dev",
    "build": "pnpm typecheck && pnpm --filter @orbit/web build && pnpm --filter @orbit/worker build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @orbit/web test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:push": "supabase db push",
    "deploy:worker": "pnpm --filter @orbit/worker run deploy",
    "deploy:web": "pnpm --filter @orbit/web run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
