VITE_APP_NAME=Talksy
VITE_APP_URL=http://localhost:5173

# Supabase project (Dashboard > Project Settings > API Keys)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the "publishable" key (sb_publishable_...). Projects that still show the legacy
# "anon public" JWT key can paste that value here instead — it maps 1:1.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend endpoints (Cloudflare Worker)
VITE_API_BASE_URL=http://localhost:8787
VITE_WS_BASE_URL=ws://localhost:8787

# Optional Turnstile (must match the secret configured in Supabase Auth > Bot Protection
# and/or the Worker TURNSTILE_SECRET_KEY)
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
VITE_ENABLE_TURNSTILE=false

# Environment
VITE_APP_ENV=development

# NEVER put the Supabase service-role key in any VITE_ variable — VITE_ values ship to browsers.
